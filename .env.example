# ---------------------------------------------------------------------------
# CodeDoc configuration -- copy to .env and fill in, or export these variables
# directly in your shell. NEVER commit a real key: .env is git-ignored and the
# pipeline refuses to call a model without a key.
# ---------------------------------------------------------------------------
# Required for any step that calls a model (main.py --process True)
LLM_KEY=your_api_key_here

# Any OpenAI-compatible endpoint
LLM_URL=https://api.openai.com/v1

# Model used for generation, refinement and judging.
# The paper's experiments used a single model family for all three roles;
# set this to the model identifier you intend to reproduce with.
MODEL=gpt-4o-mini
